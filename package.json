{
  "name": "viral-studio",
  "version": "0.15.1",
  "private": true,
  "license": "UNLICENSED",
  "author": "Viral Studio",
  "description": "Research news, product video and social content workspace with DreamFace",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.js",
    "build": "vite build",
    "desktop": "electron .",
    "pack": "npm run pack:portable",
    "setup:captions": "node scripts/setup-news-captions.mjs",
    "pack:portable": "node scripts/setup-news-captions.mjs --check && node scripts/setup-windows-runtime.mjs --check && npm run build && electron-builder --win portable --publish never",
    "pack:installer": "node scripts/setup-news-captions.mjs --check && node scripts/setup-windows-runtime.mjs --check && npm run build && electron-builder --win nsis --publish never",
    "pack:release": "node scripts/setup-news-captions.mjs --check && node scripts/setup-windows-runtime.mjs --check && npm run build && electron-builder --win nsis portable --publish never",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "test:ui": "node tests/browser.mjs",
    "test:workspaces": "node tests/workspaces-browser.mjs",
    "test:sample-render": "node tests/sample-render.mjs",
    "setup:windows": "node scripts/setup-windows-runtime.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "fontkit": "2.0.4",
    "lucide-react": "1.61.0",
    "multer": "2.5.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.viral.studio",
    "productName": "Viral Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "server/**",
      "shared/**",
      "dist/**",
      "build/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/news-captions",
        "to": "news-captions",
        "filter": [
          "*.exe",
          "*.dll",
          "*.bin",
          "*.txt",
          "manifest.json"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "*.exe",
          "*.txt"
        ]
      },
      {
        "from": "runtime/windows-runtime",
        "to": "windows-runtime",
        "filter": [
          "vc_redist.x64.exe"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/playwright*/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viral Studio",
      "artifactName": "Viral.Studio.Setup.${version}.${ext}"
    },
    "portable": {
      "unpackDirName": true,
      "artifactName": "Viral.Studio.${version}.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
